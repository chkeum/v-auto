        <!-- State: Normal -->
        <mxCell id="state1" value="State 1: Normal Operation (conn_0 READY)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="1000" height="40" as="geometry" />
        </mxCell>

        <mxCell id="conn0a" value="conn_0&#xa;(Priority: 0)&#xa;READY ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="160" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="conn1a" value="conn_1&#xa;(Priority: 1)&#xa;READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="160" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="conn2a" value="conn_2&#xa;(Priority: 2)&#xa;READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="160" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="active1" value="Active Connection" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#009900" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="160" height="30" as="geometry" />
        </mxCell>

        <!-- State: Failover to conn_1 -->
        <mxCell id="state2" value="State 2: Failover to conn_1 (conn_0 FAILED)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="1000" height="40" as="geometry" />
        </mxCell>

        <mxCell id="conn0b" value="conn_0&#xa;(Priority: 0)&#xa;FAILED ✗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="380" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="conn1b" value="conn_1&#xa;(Priority: 1)&#xa;READY ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="380" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="conn2b" value="conn_2&#xa;(Priority: 2)&#xa;READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="active2" value="Active Connection" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#009900" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="160" height="30" as="geometry" />
        </mxCell>

        <mxCell id="reconnect1" value="conn_0 reconnecting..." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#cc0000" vertex="1" parent="1">
          <mxGeometry x="120" y="470" width="160" height="30" as="geometry" />
        </mxCell>

        <!-- State: Recovery -->
        <mxCell id="state3" value="State 3: Recovery (conn_0 back to READY)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="1000" height="40" as="geometry" />
        </mxCell>

        <mxCell id="conn0c" value="conn_0&#xa;(Priority: 0)&#xa;READY ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="600" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="conn1c" value="conn_1&#xa;(Priority: 1)&#xa;READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="600" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="conn2c" value="conn_2&#xa;(Priority: 2)&#xa;READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="600" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="active3" value="Active Connection&#xa;(Switched back to conn_0)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#009900" vertex="1" parent="1">
          <mxGeometry x="120" y="690" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Notes -->
        <mxCell id="note5-1" value="Failover Logic:&#xa;• GetActiveConn() always returns highest priority READY connection&#xa;• ConnMgr continuously attempts reconnection in background&#xa;• State transitions: CONNECTING → READY (on success) or FAILED (on error)&#xa;• Automatic recovery when higher priority connection becomes available" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="160" width="360" height="520" as="geometry" />
        </mxCell>

      </root>
