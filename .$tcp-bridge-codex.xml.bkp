        <mxCell id="cf_nats_lane" value="Flow A: NATS -&gt; TCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#5b8def;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="880" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="cf_tcp_lane" value="Flow B: TCP -&gt; NATS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e6;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="960" y="80" width="880" height="420" as="geometry"/>
        </mxCell>

        <mxCell id="a1" value="NATS Subscriber\nSubscribeWithQueue(external_req_subject)\nqueue: tcp-bridge-workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="HandleExternalRequest()\n- generate TID (daily reset)\n- determine msg_type (payload/default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="RPC only: Inflight-A Register\n(tid, replySubject, deadline, phase=P)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="550" y="140" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="sendAndWaitWithRetry()\nfor each READY conn by priority\nretry_attempts + retry_delay\nconn.Write(serialized frame)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="70" y="270" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="TCP Response\nApp.handleTCPResponse() -&gt;\nInflightA.HandleResponse(TID match)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="380" y="290" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="on response: PublishReply(replySubject)\nhandler returns success -&gt; msg.Ack()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="650" y="280" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a7" value="On all attempts fail/timeout:\nInflight-A Remove + replyError + Ack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="650" y="390" width="240" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="b1" value="ConnMgr.readLoop()\nread business frame\nset frame.ConnectionID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="990" y="140" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="TCP Reader.handleFrame()\nrequest(odd) -&gt; onRequestFrame\nresponse(even) -&gt; inflight-A path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
