  <diagram id="tcp-conn" name="TCP Conn Management">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="cm_title" value="TCP Connection Management (priority + failover + keepalive)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="cm_mgr" value="ConnectionManager\n- connections[] (priority index)\n- selector: PriorityConnSelector\n- Write(): active READY conn\n- SetFrameReadCallback()" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="320" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="cm_selector" value="PriorityConnSelector\nReEvaluate() on state change\nselect lowest priority READY\nactivePriority: -1 if none" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="430" y="90" width="320" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="cm_state" value="Per-ConnMgr state machine\nDISCONNECTED/CONNECT_FAILED -&gt; CONNECTING -&gt; READY\nhandshake fail -&gt; CONNECT_FAILED\nruntime error/timeout -&gt; DISCONNECTED\nconnectionLoop ticker: 5s reconnect" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="800" y="90" width="350" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="cm_hs" value="Handshake\nHELLO frame (type 0x01, TID 0)\nwait ACK (0x02)\nparse JSON: code, ping-interval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="280" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="cm_ping" value="Ping Loop\nif !awaitingPong and idle &gt;= pingInterval: send PING\nawaitingPong=true + lastActivity=now\nif awaitingPong and idle &gt; pingTimeout: close + reconnect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="320" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="cm_read" value="readLoop\nread header/payload\nhandle ping/pong locally\nbusiness frames -&gt; callback\nframe.ConnectionID set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="760" y="330" width="300" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="cm_write" value="write path\nSender.SendFrame -&gt; connMgr.Write(active)\nSender.SendFrameToConnection -&gt; connMgr.WriteToConnection(id)\nset write deadline + update lastActivity on success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="1100" y="330" width="300" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="cm_note" value="NATS -&gt; TCP retry strategy uses connMgr.GetConnections()\npriority loop + per-connection retry_attempts\n(implemented in worker.sendAndWaitWithRetry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="640" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e_cm1" style="endArrow=block;html=1;strokeColor=#82b366" edge="1" parent="1" source="cm_mgr" target="cm_selector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cm2" style="endArrow=block;html=1;strokeColor=#82b366" edge="1" parent="1" source="cm_selector" target="cm_state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cm3" style="endArrow=block;html=1;strokeColor=#d79b00" edge="1" parent="1" source="cm_state" target="cm_hs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cm4" style="endArrow=block;html=1;strokeColor=#6c8ebf" edge="1" parent="1" source="cm_hs" target="cm_ping"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cm5" style="endArrow=block;html=1;strokeColor=#82b366" edge="1" parent="1" source="cm_state" target="cm_read"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cm6" style="endArrow=block;html=1;strokeColor=#b85450" edge="1" parent="1" source="cm_mgr" target="cm_write"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
