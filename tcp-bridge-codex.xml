  <diagram id="refactor-roadmap" name="Refactor Roadmap">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rr_title" value="Refactoring Options, Expected Impact and Recommended Order" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rr_now" value="Current pain points&#xa;1. TCP read path blocks on HandleTCPRequest() / NATS RPC&#xa;2. Sender uses one global mutex for all writes&#xa;3. Inflight-B has channel fields but current TCP-&gt;NATS flow is direct sync request/response&#xa;4. SendQueue exists but is not part of current runtime path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="rr_goal" value="Target direction&#xa;Decouple socket read from business latency, reduce unnecessary global serialization, and make backpressure explicit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e6;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="640" y="70" width="470" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rr_lane1" value="Priority 1: High impact / lower risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="rr_lane2" value="Priority 2: Medium impact / medium risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#5b8def;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="630" y="230" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="rr_p1a" value="P1-A Separate TCP read from business handling&#xa;Change point: Reader.handleFrame() / TCPInboundHandler.DispatchRequestFrame()&#xa;Approach: hand off request frames to worker goroutine or bounded per-connection work queue&#xa;Effect: same connection can keep reading while NATS RPC is in-flight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="70" y="270" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rr_p1b" value="P1-B Keep response affinity per connection&#xa;If P1-A is applied, retain connectionID on frame and continue SendFrameToConnection(connectionID) for reply path&#xa;Effect: concurrency improves without breaking request/response routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="70" y="420" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rr_p1c" value="P1-C Add explicit worker/backpressure metrics&#xa;Measure queue depth, in-flight request count, dropped frames, handler latency&#xa;Effect: lets you validate whether decoupling actually removes read stalls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="70" y="550" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rr_p2a" value="P2-A Replace single Sender mutex with per-connection serialization&#xa;Change point: tcp.Sender&#xa;Approach: move write lock into ConnMgr or use per-connection writer worker&#xa;Effect: writes to different TCP connections no longer block each other" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="660" y="270" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rr_p2b" value="P2-B Decide one model for outbound writes&#xa;Option 1: keep direct write path&#xa;Option 2: revive SendQueue as real bounded queue with consumer goroutine&#xa;Effect: removes ambiguity and makes overload behavior deterministic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="660" y="410" width="500" height="110" as="geometry" />
        </mxCell>
